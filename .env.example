# Server Configuration
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/footmarq

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost:3000/auth/google/callback

# Optional SMTP Email Credentials for OTP Sending (Nodemailer)
# (If left empty, OTP codes will log directly in your terminal console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
FROM_EMAIL="Footmarq Security" <security@footmarq.com>
