<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password — My_Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: var(--bg-base); }
    .fp-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 52px; max-width: 420px; width: 100%; text-align: center; }
  </style>
</head>
<body>
<div class="fp-card">
  <div style="font-size:3rem;margin-bottom:16px">🔑</div>
  <h2 style="font-size:1.5rem;margin-bottom:8px">Reset your password</h2>
  <p style="color:var(--text-secondary);margin-bottom:28px;font-size:0.9rem">Enter your email address and we'll send you a secure reset link.</p>
  <form action="/login" method="GET">
    <div class="form-group" style="text-align:left">
      <label class="form-label" for="email">Email address</label>
      <input class="form-input" type="email" id="email" name="email" placeholder="kumarshivam51238@gmail.com" required>
    </div>
    <button type="submit" class="btn btn-primary w-full" style="justify-content:center;margin-top:4px" onclick="showToast('Reset link sent!','success')">
      Send Reset Link →
    </button>
  </form>
  <div style="margin-top:20px;font-size:0.82rem;color:var(--text-muted)">
    <a href="/login" style="color:var(--accent-light)">← Back to sign in</a>
  </div>
</div>
<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
</body>
</html>
