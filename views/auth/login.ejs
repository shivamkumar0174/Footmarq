<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — My_Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-page">
  <div class="auth-left">
    <div class="auth-hero">
      <div class="auth-hero-badge">🔐 My_Login — Digital Identity Hub</div>
      <h1>Control your digital identity</h1>
      <p>Discover every account linked to your email. Monitor breaches. Clean up your digital footprint. All in one place — with complete privacy.</p>
      <div class="feature-list">
        <div class="feature-item">
          <div class="feature-icon">🔍</div>
          Automatically discovers all services linked to your Gmail
        </div>
        <div class="feature-item">
          <div class="feature-icon">🚨</div>
          Real-time breach monitoring against HaveIBeenPwned
        </div>
        <div class="feature-item">
          <div class="feature-icon">📊</div>
          Transparent risk scoring — no black boxes
        </div>
        <div class="feature-item">
          <div class="feature-icon">🧹</div>
          Guided account cleanup to deletion pages
        </div>
        <div class="feature-item">
          <div class="feature-icon">🔒</div>
          We never read email body content — metadata only
        </div>
      </div>
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-form-container">
      <div class="auth-logo">
        <div class="logo-mark">M</div>
        <div class="logo-text">My<span>_Login</span></div>
      </div>
      <h2 class="auth-title">Welcome back</h2>
      <p class="auth-subtitle">Sign in to your account to continue</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;padding:10px 14px;border-radius:8px;font-size:0.85rem;margin-bottom:16px;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <button class="btn-google" onclick="showToast('Google OAuth coming soon — use email/password for now', 'info')">
        <svg class="google-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </button>

      <div class="divider-text" style="margin:18px 0">or continue with email</div>

      <form action="/dashboard" method="GET">
        <div class="form-group">
          <label class="form-label" for="email">Email address</label>
          <input class="form-input" type="email" id="email" name="email" placeholder="kumarshivam51238@gmail.com" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="password">
            Password
            <a href="/forgot-password" style="float:right;color:var(--accent-light);font-size:0.78rem;font-weight:500">Forgot password?</a>
          </label>
          <input class="form-input" type="password" id="password" name="password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary w-full" style="justify-content:center;margin-top:4px">
          Sign In →
        </button>
      </form>

      <div class="auth-footer">
        Don't have an account? <a href="/register">Create one free</a>
      </div>
    </div>
  </div>
</div>
<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
</body>
</html>
