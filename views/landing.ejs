<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="My_Login — Know every account linked to your email. Discover, monitor, and clean up your digital footprint.">
  <title>My_Login — Digital Identity Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="landing-page">

  <!-- Navbar -->
  <nav class="landing-nav">
    <div class="flex gap-12" style="align-items:center">
      <div class="logo-mark">M</div>
      <span style="font-size:1rem;font-weight:700;color:var(--text-primary)">My<span
          style="color:var(--accent-light)">_Login</span></span>
    </div>
    <div class="landing-nav-links">
      <a href="#features">Features</a>
      <a href="#privacy">Privacy</a>
      <a href="#security">Security</a>
      <a href="https://github.com/shivamkumar0174/Footmarq" target="_blank">GitHub</a>
    </div>
    <div class="landing-nav-actions" style="display:flex;align-items:center;gap:10px;">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-ghost btn-sm"
          style="display:flex;align-items:center;gap:8px;padding:4px 14px 4px 6px;border-radius:99px;background:var(--bg-elevated);border:1px solid var(--border);text-decoration:none;">
          <div
            style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg, var(--accent-light, #818cf8), var(--accent-primary, #6366f1));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.75rem;">
            <%= user.avatar || (user.name ? user.name[0] : 'U' ) %>
          </div>
          <span style="font-weight:600;font-size:0.85rem;color:var(--text-primary)">
            <%= user.name ? user.name.split(' ')[0] : ' Profile' %>
          </span>
        </a>
        <a href="/logout" class="btn btn-ghost btn-sm" title="Logout" onclick="return confirm('Sign out?')"
          style="padding:6px 10px;display:flex;align-items:center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
        <% } else { %>
          <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
          <a href="/register" class="btn btn-primary btn-sm">Get Started Free</a>
          <% } %>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-badge">
      <span>🔐</span> Privacy-First Identity Hub
    </div>
    <h1>Know Every Account<br>Linked to Your Email</h1>
    <p>My_Login scans your inbox metadata to discover every service you've signed up for — then monitors breaches,
      scores your risk, and helps you clean up your digital footprint.</p>
    <div class="hero-actions">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">
          📊 Open Dashboard →
        </a>
        <% } else { %>
          <a href="/onboarding" class="btn btn-primary btn-lg">
            🚀 Connect Gmail & Scan Free
          </a>
          <a href="/dashboard" class="btn btn-ghost btn-lg">
            📊 View Demo Dashboard
          </a>
          <% } %>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><strong>71</strong> avg. accounts found</div>
      <div class="hero-stat-divider">·</div>
      <div class="hero-stat"><strong>3 in 5</strong> users have active breaches</div>
      <div class="hero-stat-divider">·</div>
      <div class="hero-stat"><strong>100%</strong> privacy — we never read email body</div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section" id="features">
    <div class="section-label">What We Do</div>
    <h2 class="section-title">Your complete digital identity, in one place</h2>
    <p class="section-subtitle">We scan Gmail metadata — never the body of your emails — to build a complete picture of
      your online accounts.</p>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-card-icon">🔍</div>
        <h3>Account Discovery</h3>
        <p>Automatically finds every service linked to your Gmail by scanning sender metadata and subject patterns. No
          email body is ever read or stored.</p>
      </div>
      <div class="feature-card">
        <div class="feature-card-icon">🚨</div>
        <h3>Breach Monitoring</h3>
        <p>Checks your emails against the HaveIBeenPwned breach database weekly. Get alerted the moment your data
          appears in a new breach.</p>
      </div>
      <div class="feature-card">
        <div class="feature-card-icon">📊</div>
        <h3>Risk Scoring</h3>
        <p>Every account gets a transparent, deterministic risk score based on breach status, inactivity, 2FA, and
          account age. No black boxes.</p>
      </div>
      <div class="feature-card">
        <div class="feature-card-icon">🛡️</div>
        <h3>Security Center</h3>
        <p>An aggregate security score 0–100 with a prioritized action list. Know exactly what to fix and in what order.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-card-icon">🧹</div>
        <h3>Account Cleanup</h3>
        <p>Guided flow to official deletion pages for every inactive or risky account you find. Clean up your footprint
          with confidence.</p>
      </div>
      <div class="feature-card">
        <div class="feature-card-icon">📧</div>
        <h3>Multi-Email Support</h3>
        <p>Connect multiple Gmail accounts to get a complete picture across all your email identities — personal, work,
          old accounts.</p>
      </div>
    </div>
  </section>

  <!-- Privacy Promise -->
  <section id="privacy" style="padding: 60px 60px;">
    <div class="privacy-banner">
      <div class="privacy-banner-content" style="flex:1">
        <div class="privacy-badge">✅ Privacy-First by Design</div>
        <h2>We read metadata,<br>never your emails</h2>
        <p>We only access what we need. Google's <code>gmail.readonly</code> scope lets us read metadata — sender,
          subject line, date — and nothing else.</p>
        <div class="privacy-points">
          <div class="privacy-point"><span class="privacy-check">✓</span> We read: sender address, subject line,
            timestamp</div>
          <div class="privacy-point"><span class="privacy-check">✓</span> We store: which services sent you emails</div>
          <div class="privacy-point"><span class="privacy-check">✓</span> Zero password storage — ever</div>
          <div class="privacy-point" style="color:var(--risk-critical)"><span class="privacy-check"
              style="color:var(--risk-critical)">✕</span> We never read email body content</div>
          <div class="privacy-point" style="color:var(--risk-critical)"><span class="privacy-check"
              style="color:var(--risk-critical)">✕</span> We never log in to services on your behalf</div>
        </div>
      </div>
      <div style="flex-shrink:0;text-align:center">
        <div style="font-size:5rem;margin-bottom:12px">🔒</div>
        <div
          style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);border-radius:12px;padding:16px 20px;text-align:center;">
          <div style="font-size:1.8rem;font-weight:800;color:var(--risk-low)">0</div>
          <div style="font-size:0.75rem;color:var(--text-muted)">Email bodies stored</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" id="security">
    <div class="cta-box">
      <div style="font-size:3rem;margin-bottom:16px">🔐</div>
      <h2>Ready to audit your digital life?</h2>
      <p>Scan your Gmail for free. No credit card required. Get your security score in under 2 minutes.</p>
      <a href="/onboarding" class="btn btn-primary btn-lg">
        Start Your Free Scan →
      </a>
      <div style="margin-top:20px;font-size:0.8rem;color:var(--text-muted)">
        Already have an account? <a href="/login" style="color:var(--accent-light)">Sign in</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="landing-footer">
    <div class="flex gap-12" style="align-items:center">
      <div class="logo-mark" style="width:28px;height:28px;font-size:14px">M</div>
      <span style="color:var(--text-muted)">My_Login by Shivam ❤️ © 2026</span>
    </div>
    <div class="footer-links">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="#" id="openContactPanel">Contact</a>
    </div>
  </footer>

  <!-- Slide-over Contact Panel -->
  <div id="contactPanelOverlay" class="contact-panel-overlay hidden"></div>
  <div id="contactPanel" class="contact-panel hidden">
    <div class="panel-header">
      <h3>Contact Support</h3>
      <button id="closeContactPanel" class="close-btn">&times;</button>
    </div>
    <div class="panel-body">
      <p style="color:var(--text-muted); margin-bottom: 24px;">Got a question? Send us a message and we'll get back to you as soon as possible.</p>
      
      <form id="contactForm">
        <div class="form-group">
          <label>Name</label>
          <input type="text" id="contactName" name="name" class="form-control" placeholder="Your Name" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="contactEmail" name="email" class="form-control" placeholder="Your Email" required>
        </div>
        <div class="form-group">
          <label>Message</label>
          <textarea id="contactMessage" name="message" class="form-control" rows="5" placeholder="How can we help?" required></textarea>
        </div>
        <button type="submit" id="contactSubmitBtn" class="btn btn-primary" style="width:100%; margin-top:16px;">
          <span class="btn-text">Send Message</span>
        </button>
      </form>
      
      <div id="contactSuccess" class="hidden" style="margin-top: 24px; text-align:center; padding:16px; background:rgba(0,255,100,0.1); border-radius:12px; border:1px solid rgba(0,255,100,0.2);">
        <div style="font-size:2rem; margin-bottom:8px;">✅</div>
        <h4 style="color:var(--text-main);">Message Sent!</h4>
        <p style="color:var(--text-muted); font-size:0.9rem;">We've received your message and will get back to you shortly.</p>
      </div>
      <div id="contactError" class="hidden" style="margin-top: 16px; color: #ff5555; text-align:center; font-size: 0.9rem;"></div>
    </div>
  </div>

  <style>
    /* Contact Panel Styles */
    .contact-panel-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(4px);
      z-index: 9998;
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    .contact-panel-overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .contact-panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 400px;
      max-width: 100%;
      background: var(--bg-surface);
      border-left: 1px solid var(--border-color);
      z-index: 9999;
      transform: translateX(0);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      box-shadow: -10px 0 30px rgba(0,0,0,0.5);
    }
    .contact-panel.hidden {
      transform: translateX(100%);
    }
    .panel-header {
      padding: 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .panel-header h3 {
      margin: 0;
      font-size: 1.25rem;
    }
    .close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
      transition: color 0.2s;
    }
    .close-btn:hover {
      color: var(--text-main);
    }
    .panel-body {
      padding: 24px;
      flex: 1;
      overflow-y: auto;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: var(--text-main);
      font-size: 0.9rem;
    }
    .form-control {
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px;
      color: var(--text-main);
      font-family: inherit;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--accent-light);
      background: rgba(255,255,255,0.1);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const openBtn = document.getElementById('openContactPanel');
      const closeBtn = document.getElementById('closeContactPanel');
      const panel = document.getElementById('contactPanel');
      const overlay = document.getElementById('contactPanelOverlay');
      const form = document.getElementById('contactForm');
      const successDiv = document.getElementById('contactSuccess');
      const errorDiv = document.getElementById('contactError');
      const submitBtn = document.getElementById('contactSubmitBtn');

      if(!openBtn || !panel) return;

      function openPanel(e) {
        if(e) e.preventDefault();
        panel.classList.remove('hidden');
        overlay.classList.remove('hidden');
        // Reset form state
        form.reset();
        form.style.display = 'block';
        successDiv.classList.add('hidden');
        errorDiv.classList.add('hidden');
      }

      function closePanel() {
        panel.classList.add('hidden');
        overlay.classList.add('hidden');
      }

      openBtn.addEventListener('click', openPanel);
      closeBtn.addEventListener('click', closePanel);
      overlay.addEventListener('click', closePanel);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorDiv.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Sending...';

        const data = {
          name: document.getElementById('contactName').value,
          email: document.getElementById('contactEmail').value,
          message: document.getElementById('contactMessage').value
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          
          if(result.success) {
            form.style.display = 'none';
            successDiv.classList.remove('hidden');
            setTimeout(closePanel, 3000);
          } else {
            errorDiv.textContent = result.message || 'An error occurred.';
            errorDiv.classList.remove('hidden');
          }
        } catch(err) {
          errorDiv.textContent = 'Network error. Please try again later.';
          errorDiv.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span class="btn-text">Send Message</span>';
        }
      });
    });
  </script>

  <script src="/js/app.js"></script>
</body>

</html>