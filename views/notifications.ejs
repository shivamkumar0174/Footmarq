<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications — My_Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { user, page, notifications: notifications.filter ? notifications.filter(n=>!n.read).length : 0 }) %>
  <div class="main-content">
    <header class="topbar">
      <div class="topbar-title">Notifications</div>
      <div class="topbar-actions">
        <button class="icon-btn" onclick="showToast('All marked as read','success')" title="Mark all read">✓</button>
        <a href="/settings" class="icon-btn">⚙️</a>
      </div>
    </header>
    <div class="page-body">
      <div class="flex-between mb-24">
        <div>
          <h1 style="font-size:1.5rem;margin-bottom:4px">Notifications</h1>
          <p class="page-subtitle"><%= notifications.filter(n=>!n.read).length %> unread notifications</p>
        </div>
        <button class="btn btn-ghost btn-sm" onclick="showToast('All marked as read','success')">Mark all read</button>
      </div>

      <% const notifIcons = {breach:'🚨',scan:'🔍',risk:'📊',tip:'💡',info:'ℹ️'}; %>
      <% notifications.forEach(function(notif) { %>
        <div class="notif-item <%= !notif.read ? (notif.severity === 'critical' ? 'critical' : 'unread') : '' %>">
          <span class="notif-icon"><%= notifIcons[notif.type] || 'ℹ️' %></span>
          <div class="notif-body">
            <div class="notif-title"><%= notif.title %></div>
            <div class="notif-message"><%= notif.message %></div>
            <div class="notif-time"><%= notif.time %></div>
          </div>
          <% if (!notif.read) { %>
            <div class="unread-dot"></div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
</body>
</html>
