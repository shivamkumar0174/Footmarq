<header class="topbar">
  <div class="topbar-title">
    <% if (typeof pageTitle !== 'undefined') { %>
      <%= pageTitle %>
    <% } %>
  </div>

  <% if (typeof showSearch !== 'undefined' && showSearch) { %>
  <form class="topbar-search" action="/dashboard" method="GET">
    <span class="search-icon">🔍</span>
    <input
      type="text"
      id="topbar-search-input"
      name="search"
      placeholder="Search accounts, services..."
      value="<%= typeof search !== 'undefined' ? search : '' %>"
      autocomplete="off"
    >
    <% if (typeof activeCategory !== 'undefined' && activeCategory !== 'all') { %>
      <input type="hidden" name="category" value="<%= activeCategory %>">
    <% } %>
  </form>
  <% } %>

  <div class="topbar-actions">
    <a href="/" class="btn btn-ghost btn-sm" title="Go to Main Page" style="display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;font-size:0.82rem;font-weight:600;text-decoration:none;">
      🏠 Home Page
    </a>
    <a href="/notifications" class="icon-btn" title="Notifications">
      🔔
      <% if (typeof notifications !== 'undefined' && notifications > 0) { %>
        <span class="notif-dot"></span>
      <% } %>
    </a>
    <a href="/settings" class="icon-btn" title="Settings">⚙️</a>
    <a href="/logout" class="icon-btn" title="Logout" onclick="return confirm('Sign out?')">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
    </a>
  </div>
</header>
