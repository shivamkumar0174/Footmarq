<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings — My_Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', { user, notifications, page }) %>
  <div class="main-content">
    <header class="topbar">
      <div class="topbar-title">Settings</div>
      <div class="topbar-actions">
        <a href="/" class="btn btn-ghost btn-sm" title="Go to Main Page" style="display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;font-size:0.82rem;font-weight:600;text-decoration:none;">
          🏠 Home Page
        </a>
        <a href="/notifications" class="icon-btn">🔔<% if(notifications>0){%><span class="notif-dot"></span><%}%></a>
        <a href="/logout" class="icon-btn" title="Logout" onclick="return confirm('Sign out?')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        </a>
      </div>
    </header>
    <div class="page-body">
      <div class="page-header">
        <h1>Settings</h1>
        <p class="page-subtitle">Manage your profile, security, notifications, and privacy preferences.</p>
      </div>

      <div class="settings-grid">
        <!-- Settings Sidebar Nav -->
        <div class="settings-sidebar">
          <a href="/settings?tab=profile" class="settings-nav-link <%= tab === 'profile' ? 'active' : '' %>">👤 Profile</a>
          <a href="/settings?tab=security" class="settings-nav-link <%= tab === 'security' ? 'active' : '' %>">🔒 Security</a>
          <a href="/settings?tab=notifications" class="settings-nav-link <%= tab === 'notifications' ? 'active' : '' %>">🔔 Notifications</a>
          <a href="/settings?tab=sessions" class="settings-nav-link <%= tab === 'sessions' ? 'active' : '' %>">💻 Sessions</a>
          <a href="/settings?tab=privacy" class="settings-nav-link <%= tab === 'privacy' ? 'active' : '' %>">🛡️ Privacy</a>
        </div>

        <!-- Settings Panel -->
        <div class="settings-panel">

          <% if (tab === 'profile') { %>
            <div class="settings-section">
              <h3>Profile Information</h3>
              <div class="profile-avatar-row">
                <div class="profile-avatar-large"><%= user.avatar %></div>
                <div>
                  <div style="font-size:0.9rem;font-weight:600;color:var(--text-primary)"><%= user.name %></div>
                  <div style="font-size:0.8rem;color:var(--text-muted)">Member since <%= user.joinedDate %></div>
                  <button class="btn btn-ghost btn-sm" style="margin-top:8px" onclick="showToast('Avatar upload coming soon','info')">Change Avatar</button>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Full Name</label>
                <input class="form-input" type="text" value="<%= user.name %>" readonly>
              </div>
              <div class="form-group">
                <label class="form-label">Primary Email</label>
                <input class="form-input" type="email" value="<%= user.email %>" readonly>
              </div>
              <button class="btn btn-primary btn-sm" onclick="showToast('Profile saved','success')">Save Changes</button>
            </div>

            <div class="divider"></div>
            <div class="settings-section">
              <h3>Plan</h3>
              <div style="display:flex;align-items:center;justify-content:space-between;background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius);padding:16px">
                <div>
                  <div style="font-size:0.9rem;font-weight:600;color:var(--text-primary)">Free Plan</div>
                  <div style="font-size:0.8rem;color:var(--text-muted)">Full account discovery · 1 email · Weekly breach scans</div>
                </div>
                <button class="btn btn-primary btn-sm" onclick="showToast('Pro plan coming soon!','info')">Upgrade to Pro</button>
              </div>
            </div>

          <% } else if (tab === 'security') { %>
            <div class="settings-section">
              <h3>Change Password</h3>
              <div class="form-group">
                <label class="form-label">Current Password</label>
                <input class="form-input" type="password" placeholder="••••••••">
              </div>
              <div class="form-group">
                <label class="form-label">New Password</label>
                <input class="form-input" type="password" placeholder="Min 8 chars, 1 uppercase, 1 number">
              </div>
              <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <input class="form-input" type="password" placeholder="Repeat new password">
              </div>
              <button class="btn btn-primary btn-sm" onclick="showToast('Password updated','success')">Update Password</button>
            </div>

            <div class="divider"></div>
            <div class="settings-section">
              <h3>Two-Factor Authentication</h3>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
                <div>
                  <div style="font-size:0.875rem;font-weight:600;color:var(--text-primary)">Authenticator App (TOTP)</div>
                  <div style="font-size:0.8rem;color:var(--text-muted)">Use Google Authenticator or Authy</div>
                </div>
                <button class="btn btn-primary btn-sm" onclick="showToast('TOTP setup coming in backend phase','info')">Enable 2FA</button>
              </div>
            </div>

          <% } else if (tab === 'notifications') { %>
            <div class="settings-section">
              <h3>Notification Preferences</h3>
              <% const notifPrefs = [
                {label:'Breach Alerts', desc:'Notify when a new breach is detected on your accounts', key:'breach'},
                {label:'Scan Complete', desc:'Notify when a Gmail scan finishes', key:'scan'},
                {label:'Security Score Change', desc:'Notify when your score drops significantly', key:'score'},
                {label:'Weekly Digest', desc:'Weekly summary of your account status', key:'weekly'},
                {label:'Security Tips', desc:'Proactive tips to improve your security', key:'tips'},
              ]; %>
              <% notifPrefs.forEach(function(pref) { %>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border)">
                  <div>
                    <div style="font-size:0.875rem;font-weight:500;color:var(--text-primary)"><%= pref.label %></div>
                    <div style="font-size:0.78rem;color:var(--text-muted)"><%= pref.desc %></div>
                  </div>
                  <label style="position:relative;display:inline-block;width:40px;height:22px;cursor:pointer">
                    <input type="checkbox" checked style="opacity:0;width:0;height:0" onchange="showToast('Preference saved','success')">
                    <span style="position:absolute;inset:0;background:var(--accent);border-radius:99px;transition:0.2s"></span>
                    <span style="position:absolute;left:3px;top:3px;width:16px;height:16px;background:white;border-radius:50%;transition:0.2s"></span>
                  </label>
                </div>
              <% }) %>
            </div>

          <% } else if (tab === 'sessions') { %>
            <div class="settings-section">
              <h3>Active Sessions</h3>
              <% const sessions = [
                {device:'Chrome on macOS', ip:'182.64.xx.xx', location:'Mumbai, India', current:true, time:'Now'},
                {device:'Firefox on Windows', ip:'103.28.xx.xx', location:'Delhi, India', current:false, time:'2 days ago'},
                {device:'Safari on iPhone', ip:'45.91.xx.xx', location:'Bangalore, India', current:false, time:'5 days ago'},
              ]; %>
              <% sessions.forEach(function(s) { %>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:14px;background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-sm);margin-bottom:8px">
                  <div>
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
                      <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary)"><%= s.device %></span>
                      <% if (s.current) { %><span style="background:rgba(34,197,94,0.15);color:var(--risk-low);font-size:0.65rem;font-weight:700;padding:2px 8px;border-radius:99px">Current</span><% } %>
                    </div>
                    <div style="font-size:0.78rem;color:var(--text-muted)"><%= s.ip %> · <%= s.location %> · <%= s.time %></div>
                  </div>
                  <% if (!s.current) { %>
                    <button class="btn btn-danger btn-sm" onclick="showToast('Session terminated','success')">Terminate</button>
                  <% } %>
                </div>
              <% }) %>
              <button class="btn btn-danger" style="margin-top:8px" onclick="showToast('All other sessions terminated','success')">Terminate All Other Sessions</button>
            </div>

          <% } else if (tab === 'privacy') { %>
            <div class="settings-section">
              <h3>Data Export</h3>
              <p style="font-size:0.875rem;margin-bottom:14px">Download a complete copy of your My_Login data — accounts, breach history, and activity.</p>
              <button class="btn btn-ghost" onclick="showToast('Export started. You will receive an email shortly.','success')">📥 Export My Data (JSON)</button>
            </div>
            <div class="divider"></div>
            <div class="settings-section">
              <h3>Disconnect Gmail</h3>
              <p style="font-size:0.875rem;margin-bottom:14px">Remove Gmail access. This stops all future scans. Your existing account data is retained.</p>
              <button class="btn btn-danger" onclick="showToast('Gmail disconnected','info')">Disconnect Gmail Access</button>
            </div>
            <div class="divider"></div>
            <div class="settings-section">
              <h3>Delete Account</h3>
              <p style="font-size:0.875rem;margin-bottom:14px;color:var(--text-secondary)">Permanently delete your My_Login account and all associated data. <strong style="color:var(--risk-critical)">This action cannot be undone.</strong></p>
              <button class="btn btn-danger" onclick="if(confirm('Are you sure? This deletes everything permanently.')) showToast('Account deletion scheduled','info')">🗑️ Delete My Account</button>
            </div>
          <% } %>

        </div>
      </div>
    </div>
  </div>
</div>
<div id="toast-container" class="toast-container"></div>
<script src="/js/app.js"></script>
</body>
</html>
