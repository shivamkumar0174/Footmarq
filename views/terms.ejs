<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="Footmarq Terms of Service — The rules and agreements that govern your use of the Footmarq digital identity platform.">
  <title>Terms of Service — Footmarq</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .terms-page {
      min-height: 100vh;
      background: var(--bg-base);
    }

    /* Navbar */
    .terms-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(10, 13, 20, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 0 60px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .terms-nav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .terms-nav-brand span {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .terms-nav-brand span em {
      color: var(--accent-light);
      font-style: normal;
    }

    .terms-nav-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-secondary);
      font-size: 0.875rem;
      transition: color 200ms;
      text-decoration: none;
    }

    .terms-nav-back:hover {
      color: var(--accent-light);
    }

    /* Hero */
    .terms-hero {
      padding: 80px 60px 60px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .terms-hero::before {
      content: '';
      position: absolute;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 500px;
      background: radial-gradient(ellipse, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
      pointer-events: none;
    }

    .terms-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: 99px;
      padding: 6px 16px;
      font-size: 0.78rem;
      font-weight: 600;
      color: #f59e0b;
      margin-bottom: 24px;
    }

    .terms-hero h1 {
      font-size: 3rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-bottom: 18px;
      background: linear-gradient(135deg, #fff 0%, var(--accent-light) 60%, #22d3ee 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .terms-hero p {
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.7;
    }

    .terms-meta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 28px;
      margin-top: 32px;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* Layout */
    .terms-layout {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 60px 80px;
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 48px;
      align-items: start;
    }

    /* TOC */
    .terms-toc {
      position: sticky;
      top: 88px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
    }

    .terms-toc h4 {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .toc-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .toc-link {
      display: block;
      padding: 7px 10px;
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      color: var(--text-secondary);
      transition: all 200ms;
      text-decoration: none;
    }

    .toc-link:hover {
      background: var(--bg-hover);
      color: var(--accent-light);
    }

    .toc-link.active {
      background: var(--accent-dim);
      color: var(--accent-light);
      font-weight: 500;
    }

    /* Sections */
    .terms-content {
      min-width: 0;
    }

    .terms-section {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 36px;
      margin-bottom: 24px;
      scroll-margin-top: 88px;
      transition: border-color 200ms;
    }

    .terms-section:hover {
      border-color: rgba(99, 102, 241, 0.2);
    }

    .section-icon-title {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
    }

    .section-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
    }

    .icon-purple {
      background: rgba(99, 102, 241, 0.15);
    }

    .icon-green {
      background: rgba(34, 197, 94, 0.12);
    }

    .icon-blue {
      background: rgba(34, 211, 238, 0.12);
    }

    .icon-amber {
      background: rgba(245, 158, 11, 0.12);
    }

    .icon-red {
      background: rgba(239, 68, 68, 0.12);
    }

    .icon-pink {
      background: rgba(236, 72, 153, 0.12);
    }

    .icon-teal {
      background: rgba(20, 184, 166, 0.12);
    }

    .terms-section h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
    }

    .terms-section p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.75;
      margin-bottom: 12px;
    }

    .terms-section p:last-child {
      margin-bottom: 0;
    }

    /* Rule list */
    .rule-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 16px 0;
    }

    .rule-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.875rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .rule-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent-light);
      margin-top: 8px;
      flex-shrink: 0;
    }

    .rule-yes {
      color: #22c55e;
      font-size: 1rem;
      margin-top: 1px;
      flex-shrink: 0;
    }

    .rule-no {
      color: #ef4444;
      font-size: 1rem;
      margin-top: 1px;
      flex-shrink: 0;
    }

    /* Alert box */
    .alert-box {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: rgba(99, 102, 241, 0.08);
      border: 1px solid rgba(99, 102, 241, 0.25);
      border-radius: var(--radius);
      padding: 16px;
      margin: 16px 0;
      font-size: 0.875rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .alert-box.warn {
      background: rgba(245, 158, 11, 0.07);
      border-color: rgba(245, 158, 11, 0.3);
    }

    .alert-box.danger {
      background: rgba(239, 68, 68, 0.07);
      border-color: rgba(239, 68, 68, 0.25);
    }

    .alert-icon {
      font-size: 1.1rem;
      margin-top: 1px;
      flex-shrink: 0;
    }

    /* Two-column grid */
    .terms-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 16px;
    }

    .terms-card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px;
      transition: border-color 200ms;
    }

    .terms-card:hover {
      border-color: rgba(99, 102, 241, 0.3);
    }

    .terms-card h4 {
      font-size: 0.875rem;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .terms-card p {
      font-size: 0.8rem;
      margin-bottom: 0;
    }

    /* Big disclaimer */
    .disclaimer-box {
      background: linear-gradient(135deg, var(--bg-elevated) 0%, rgba(239, 68, 68, 0.05) 100%);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: var(--radius);
      padding: 24px;
      margin: 16px 0;
    }

    .disclaimer-box p {
      font-size: 0.875rem;
      line-height: 1.7;
      margin-bottom: 0;
    }

    /* Contact box */
    .contact-box {
      background: linear-gradient(135deg, var(--bg-elevated) 0%, rgba(99, 102, 241, 0.08) 100%);
      border: 1px solid rgba(99, 102, 241, 0.25);
      border-radius: var(--radius);
      padding: 24px;
      margin-top: 16px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .contact-box-icon {
      font-size: 2rem;
    }

    .contact-box h4 {
      font-size: 0.9rem;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .contact-box p {
      font-size: 0.85rem;
      margin: 0;
    }

    .contact-box a {
      color: var(--accent-light);
      text-decoration: underline;
    }

    /* Footer */
    .terms-footer {
      border-top: 1px solid var(--border);
      padding: 32px 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--text-muted);
      font-size: 0.825rem;
    }

    .footer-links {
      display: flex;
      gap: 20px;
    }

    .footer-links a {
      color: var(--text-muted);
      transition: color 200ms;
    }

    .footer-links a:hover {
      color: var(--text-secondary);
    }

    @media (max-width: 900px) {
      .terms-nav {
        padding: 0 24px;
      }

      .terms-hero {
        padding: 60px 24px 40px;
      }

      .terms-hero h1 {
        font-size: 2.2rem;
      }

      .terms-layout {
        grid-template-columns: 1fr;
        padding: 0 24px 60px;
      }

      .terms-toc {
        position: static;
      }

      .terms-grid {
        grid-template-columns: 1fr;
      }

      .terms-footer {
        padding: 24px;
        flex-direction: column;
        gap: 16px;
      }
    }
  </style>
</head>

